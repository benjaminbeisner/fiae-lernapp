# Kopieren nach .env und ausfüllen. Die Datei .env niemals ins Git-Repo hochladen.
DJANGO_SECRET_KEY=hier-einen-langen-zufaelligen-wert-eintragen
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=lernen.example.de

DB_ENGINE=mysql
DB_NAME=fiae_lernapp
DB_USER=fiae_lernapp
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Datum der AP1 (JJJJ-MM-TT) für den Countdown
AP1_DATUM=2027-01-01
DAILY_NEW_QUESTIONS=10
DAILY_REVIEW_LIMIT=30
